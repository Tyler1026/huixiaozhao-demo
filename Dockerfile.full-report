FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir python-docx==1.1.2 psycopg2-binary
COPY report_service/ /app/report_service/
COPY backend/ /app/backend/
RUN python -m compileall -q report_service backend
ENV HXZ_ENABLE_LIVE=0 PYTHONUNBUFFERED=1
# Real production worker; absent configuration exits before research.
# Uses the existing website PostgreSQL queue and stores artifacts in that DB.
CMD ["python", "-m", "report_service.hosted"]
